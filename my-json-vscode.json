{
    "files.autoSave": "afterDelay",
    "editor.wordWrap": "on",
    "editor.fontFamily": "JetBrains Mono",
    "editor.fontLigatures": true,
    "editor.fontSize": 11,
    "editor.formatOnSave": true,
    "editor.renderLineHighlight": "gutter",
    "editor.semanticHighlighting.enabled": false,
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": true,
    "editor.linkedEditing": true,
    "editor.cursorBlinking": "smooth",
    "editor.smoothScrolling": true,
    "workbench.startupEditor": "newUntitledFile",
    "workbench.tree.indent": 12,
    "explorer.compactFolders": false,
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "top",
    "workbench.productIconTheme": "fluent-icons",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.editor.empty.hint": "hidden",
    "workbench.iconTheme": "catppuccin-perfect-dark",
    "workbench.colorCustomizations": {
        "editor.background": "#1a1f27",
        "editor.foreground": "#d4d4d4",
        "sideBar.background": "#181c23",
        "activityBar.background": "#181c23",
        "titleBar.activeBackground": "#181c23",
        "editor.lineHighlightBackground": "#2a2f3a",
        "editorCursor.foreground": "#c5cdd9",
        "terminal.background": "#00000000",
        /* Guias de Indentação Coloridas do segundo JSON */
        "editorIndentGuide.background1": "#FF4500",
        "editorIndentGuide.background2": "#FF8C00",
        "editorIndentGuide.background3": "#32CD32",
        "editorIndentGuide.background4": "#4682B4",
        "editorIndentGuide.background5": "#8A2BE2",
        "editorIndentGuide.activeBackground1": "#FF6347",
        "editorIndentGuide.activeBackground2": "#FFA500",
        "editorIndentGuide.activeBackground3": "#00FA9A",
        "editorIndentGuide.activeBackground4": "#1E90FF",
        "editorIndentGuide.activeBackground5": "#9370DB"
    },
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.suggestSmartCommit": false,
    "git.openRepositoryInParentFolders": "never",
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.initialHint": false,
    "terminal.integrated.fontSize": 12,
    "background.editorBackgrounds": [
        "/home/dudu/Downloads/wallpaper.png"
    ],
    "background.autoInstall": false,
    "settingsSync.ignoredSettings": [
        "workbench.colorCustomizations",
        "editor.tokenColorCustomizations"
    ],
    "workbench.colorTheme": "Night Owl"
}